# Local only — copy to deploy.local.env and fill in. Never commit deploy.local.env.

# Staging (optional)
SFTP_HOST=
SFTP_PORT=21
SFTP_USER=
SFTP_REMOTE_PATH=wp-content/themes/Mudt_new
SFTP_USE_PASSWORD=true
SFTP_PASSWORD=

# Deploy uploads git-changed files only (default). Full theme vs server compare:
# DEPLOY_FULL=true
# DEPLOY_ALLOW_DIRTY=true
# DEPLOY_ALLOW_UNPUSHED=true
# DRY_RUN=true
# Prod FTPS is flaky on long sessions — upload in batches (defaults: prod 25/2s, staging 50/0.5s):
# DEPLOY_BATCH_SIZE=25
# DEPLOY_BATCH_PAUSE_MS=2000

# Production
SFTP_PROD_HOST=
SFTP_PROD_PORT=21
SFTP_PROD_USER=
SFTP_PROD_REMOTE_PATH=httpdocs/wp-content/themes/Mudt_new
SFTP_PROD_USE_PASSWORD=true
SFTP_PROD_USE_FTPS=true
SFTP_PROD_PASSWORD=

# Optional one-time DB helpers (local scripts only)
# DB_HOST=localhost
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_PREFIX=
# DEV_SITE_URL=
# PROD_SITE_URL=https://uni-munich.de
