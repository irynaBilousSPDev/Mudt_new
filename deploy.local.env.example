# Dev — Hostinger (iratest.site). Plain FTP port 21 for sub-accounts.
# (Main account may use SFTP port 65002; u909863793.mudttest uses FTP 21.)
SFTP_HOST=ftp.iratest.site
SFTP_PORT=21
SFTP_USER=u909863793.mudttest
SFTP_REMOTE_PATH=wp-content/themes/Mudt_new
SFTP_USE_PASSWORD=true
SFTP_PASSWORD=your_sftp_password

# Deploy uploads git-changed files only (default). Full theme vs server compare:
# DEPLOY_FULL=true
# DEPLOY_ALLOW_DIRTY=true
# DEPLOY_ALLOW_UNPUSHED=true
# DRY_RUN=true

# prod — Plesk / Contabo (uni-munich.de). FTPS port 21.
# Plesk FTP root = home directory; theme path includes httpdocs/
SFTP_PROD_HOST=vmi1573265.contaboserver.net
SFTP_PROD_PORT=21
SFTP_PROD_USER=your_prod_sftp_username
SFTP_PROD_REMOTE_PATH=httpdocs/wp-content/themes/Mudt_new
SFTP_PROD_USE_PASSWORD=true
SFTP_PROD_USE_FTPS=true
SFTP_PROD_PASSWORD=your_prod_sftp_password

# One-time DB import only (scripts/import-db-dev.js) — not used by /deploy-dev
# DB_HOST=localhost
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_PREFIX=nIF3Zpc_
# DEV_SITE_URL=https://iratest.site
# PROD_SITE_URL=https://uni-munich.de
