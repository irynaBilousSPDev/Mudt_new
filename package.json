{
  "name": "mudt-new-theme",
  "version": "1.0.0",
  "private": true,
  "description": "MUDT WordPress theme — dev deploy to iratest.site",
  "scripts": {
    "build:css": "sass scss/reset.scss:css/reset.css scss/fonts.scss:css/fonts.css scss/footer.scss:css/footer.css --no-source-map",
    "build:js": "terser js/main.js -c -m -o js/main.min.js",
    "build": "npm run build:css && npm run build:js",
    "deploy:dev": "node scripts/deploy-dev.js dev",
    "deploy:prod": "node scripts/deploy-dev.js prod",
    "import:db:dev": "node scripts/import-db-dev.js",
    "import:uploads:dev": "node scripts/import-uploads-dev.js",
    "import:acf-pro:dev": "node scripts/import-plugin-dev.js advanced-custom-fields-pro",
    "probe:dev": "node scripts/probe-sftp.js dev",
    "probe:prod": "node scripts/probe-sftp.js prod"
  },
  "devDependencies": {
    "basic-ftp": "^6.0.1",
    "sass": "^1.101.7",
    "ssh2-sftp-client": "^12.1.1",
    "terser": "^5.49.0"
  }
}
